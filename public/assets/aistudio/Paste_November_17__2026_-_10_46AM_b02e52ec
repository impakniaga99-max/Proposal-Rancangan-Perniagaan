<!-- Interactive Script for Mobile Navigation Drawer, Search Filter, and Accordion Toggle -->
    <script>
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Close mobile menu when clicking any navigation link
        const mobileLinks = mobileMenu.querySelectorAll('a');
        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Toggle Card Body (Accordion Functionality)
        function toggleCardBody(button) {
            const section = button.closest('section');
            const content = section.querySelector('.card-collapsible-content');
            const icon = button.querySelector('.toggle-icon');
            
            if (content.style.display === 'none') {
                content.style.display = 'block';
                icon.classList.remove('fa-chevron-down');
                icon.classList.add('fa-chevron-up');
            } else {
                content.style.display = 'none';
                icon.classList.remove('fa-chevron-up');
                icon.classList.add('fa-chevron-down');
            }
        }

        // Live Search / Filter Sections
        const searchInput = document.getElementById('section-search');
        const sections = document.querySelectorAll('.proposal-section');

        searchInput.addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase().trim();
            sections.forEach(sec => {
                const keywords = sec.getAttribute('data-keywords') || '';
                const text = sec.innerText.toLowerCase();
                if (term === '' || text.includes(term) || keywords.includes(term)) {
                    sec.style.display = 'block';
                } else {
                    sec.style.display = 'none';
                }
            });
        });
    </script>

